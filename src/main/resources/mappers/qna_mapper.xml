<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.my_community.board.model.dao.QnaDao">
	<select id="getBoardList" resultType="anonymous">
		SELECT * FROM vw_qna
		ORDER BY created DESC, board_no DESC
	</select>

	<select id="getBoardCount" resultType="int">
		SELECT COUNT(*) FROM vw_qna
	</select>
	
