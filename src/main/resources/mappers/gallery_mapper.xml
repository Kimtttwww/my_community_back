<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.my_community.board.model.dao.GalleryDao">
	<select id="getBoardList" parameterType="boardSearchOption" resultType="gallery">
		SELECT * FROM VW_GALLERY
		ORDER BY created DESC, board_no DESC
		LIMIT #{offset}, #{perPage}
	</select>

	<select id="getBoardCount" parameterType="boardSearchOption" resultType="int">
		SELECT COUNT(*) FROM VW_GALLERY
	</select>
</mapper>